#!/bin/bash

set -e

# Configuration
GO_INSTALL_DIR="$HOME/.local"
GO_BIN_PATH="$GO_INSTALL_DIR/go/bin"

# Check if go/bin is in PATH
if [[ ":$PATH:" != *":$GO_BIN_PATH:"* ]]; then
    echo "Error: $GO_BIN_PATH is not in your PATH"
    echo "Please add it to your PATH environment variable"
    exit 1
fi

# Check if installation directory is user-owned (not root)
if [ ! -w "$GO_INSTALL_DIR" ]; then
    echo "Error: $GO_INSTALL_DIR is not writable by current user"
    exit 1
fi

if [ "$(stat -c '%u' "$GO_INSTALL_DIR")" = "0" ]; then
    echo "Error: $GO_INSTALL_DIR is owned by root, not the current user"
    exit 1
fi

# Get current Go version
if command -v go &> /dev/null; then
    CURRENT_VERSION=$(go version | awk '{print $3}' | sed 's/go//')
    echo "Current Go version: $CURRENT_VERSION"
else
    echo "Go is not installed"
    CURRENT_VERSION="not installed"
fi

# Fetch the latest Go version from the official Go website
echo "Checking for the latest Go version..."
LATEST_VERSION=$(curl -s https://go.dev/dl/?mode=json | jq -r '.[0].version' | sed 's/go//')

if [ -z "$LATEST_VERSION" ]; then
    echo "Failed to fetch the latest Go version"
    exit 1
fi

echo "Latest Go version: $LATEST_VERSION"

# Check if update is needed
if [ "$CURRENT_VERSION" = "$LATEST_VERSION" ]; then
    echo "You already have the latest version of Go ($LATEST_VERSION)"
    exit 0
fi

# Download the latest version
DOWNLOAD_URL="https://go.dev/dl/go${LATEST_VERSION}.linux-amd64.tar.gz"
DOWNLOAD_FILE="$HOME/Downloads/go${LATEST_VERSION}.linux-amd64.tar.gz"

echo "Downloading Go $LATEST_VERSION..."
echo "URL: $DOWNLOAD_URL"

curl -L -o "$DOWNLOAD_FILE" "$DOWNLOAD_URL"

if [ ! -f "$DOWNLOAD_FILE" ]; then
    echo "Download failed"
    exit 1
fi

echo "Download complete: $DOWNLOAD_FILE"

# Install Go
echo "Installing Go $LATEST_VERSION to $GO_INSTALL_DIR/go..."
rm -rf "$GO_INSTALL_DIR/go"
tar -C "$GO_INSTALL_DIR" -xzf "$DOWNLOAD_FILE"

# Clean up downloaded file
echo "Cleaning up downloaded file..."
rm -f "$DOWNLOAD_FILE"

echo "Go $LATEST_VERSION has been installed successfully!"
echo "You can verify the installation by running: go version"